{
  "engine": "sglang-sidtrie",
  "env": {
    "OMP_NUM_THREADS": "10",
    "MKL_NUM_THREADS": "10",
    "PYTHONUNBUFFERED": "1",
    "SGLANG_BEAM_SHARED_CONTEXT_ATTENTION": "false"
  },
  "server_settings": {
    "dtype": "bfloat16",
    "kv_cache_dtype": "auto",
    "tp_size": 1,
    "skip_tokenizer_init": true,
    "disable_radix_cache": true,
    "random_seed": 42,
    "prefill_attention_backend": "flashinfer",
    "decode_attention_backend": "flashinfer",
    "disable_overlap_schedule": true,
    "page_size": 1,
    "disable_cuda_graph": false,
    "cuda_graph_bs_decode": [256],
    "cuda_graph_bs_prefill": [2048],
    "cuda_graph_backend_prefill": "breakable",
    "chunked_prefill_size": -1,
    "max_running_requests": 512,
    "mem_fraction_static": 0.7,
    "skip_server_warmup": true,
    "log_level": "warning"
  },
  "trie_config": {
    "token_start": 1000,
    "codebook_size": 1000
  }
}
